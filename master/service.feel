-- master/service.feel — master data business logic.
-- Exposed as cross-module API: find_company, find_department, find_position.

import config

-- ─── Companies ───────────────────────────────────────────────────────────────

define list_companies taking _ ->
  db.query(config.conn,
    "SELECT * FROM master_companies WHERE is_active = 1 ORDER BY name",
    [])

define find_company taking id ->
  db.query_one(config.conn,
    "SELECT * FROM master_companies WHERE id = ?",
    [id])

define create_company taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO master_companies (name, code, address, phone, email) VALUES (?, ?, ?, ?, ?)",
      [d.name, d.code, map.get(d, "address", nothing), map.get(d, "phone", nothing), map.get(d, "email", nothing)])
    db.last_id(config.conn)
  }

define update_company taking d ->
  db.exec(config.conn,
    "UPDATE master_companies SET name=?, code=?, address=?, phone=?, email=?, updated_at=NOW() WHERE id=?",
    [d.name, d.code, map.get(d, "address", nothing), map.get(d, "phone", nothing), map.get(d, "email", nothing), d.id])

define delete_company taking id ->
  db.exec(config.conn,
    "UPDATE master_companies SET is_active=0 WHERE id=?",
    [id])

-- ─── Departments ─────────────────────────────────────────────────────────────

define list_departments taking company_id ->
  db.query(config.conn,
    "SELECT d.*, p.name AS parent_name, r.name AS default_role_name FROM master_departments d LEFT JOIN master_departments p ON d.parent_id = p.id LEFT JOIN auth_roles r ON d.default_role_id = r.id WHERE d.company_id = ? AND d.is_active = 1 ORDER BY d.name",
    [company_id])

define find_department taking id ->
  db.query_one(config.conn,
    "SELECT d.*, r.name AS default_role_name FROM master_departments d LEFT JOIN auth_roles r ON d.default_role_id = r.id WHERE d.id = ?",
    [id])

define create_department taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO master_departments (company_id, name, code, parent_id, default_role_id) VALUES (?, ?, ?, ?, ?)",
      [d.company_id, d.name, map.get(d, "code", nothing), map.get(d, "parent_id", nothing), map.get(d, "default_role_id", nothing)])
    db.last_id(config.conn)
  }

define update_department taking d ->
  db.exec(config.conn,
    "UPDATE master_departments SET name=?, code=?, parent_id=?, default_role_id=?, updated_at=NOW() WHERE id=?",
    [d.name, map.get(d, "code", nothing), map.get(d, "parent_id", nothing), map.get(d, "default_role_id", nothing), d.id])

define delete_department taking id ->
  db.exec(config.conn,
    "UPDATE master_departments SET is_active=0 WHERE id=?",
    [id])

-- ─── Positions ───────────────────────────────────────────────────────────────

define list_positions taking company_id ->
  db.query(config.conn,
    "SELECT * FROM master_positions WHERE company_id = ? AND is_active = 1 ORDER BY level, name",
    [company_id])

define find_position taking id ->
  db.query_one(config.conn,
    "SELECT * FROM master_positions WHERE id = ?",
    [id])

define create_position taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO master_positions (company_id, name, code, level) VALUES (?, ?, ?, ?)",
      [d.company_id, d.name, map.get(d, "code", nothing), map.get(d, "level", 1)])
    db.last_id(config.conn)
  }

define update_position taking d ->
  db.exec(config.conn,
    "UPDATE master_positions SET name=?, code=?, level=?, updated_at=NOW() WHERE id=?",
    [d.name, map.get(d, "code", nothing), map.get(d, "level", 1), d.id])

define delete_position taking id ->
  db.exec(config.conn,
    "UPDATE master_positions SET is_active=0 WHERE id=?",
    [id])

-- ─── Work Schedules ──────────────────────────────────────────────────────────

define list_work_schedules taking company_id ->
  db.query(config.conn,
    "SELECT * FROM master_work_schedules WHERE company_id = ? AND is_active = 1 ORDER BY is_default DESC, name",
    [company_id])

define find_work_schedule taking id ->
  db.query_one(config.conn, "SELECT * FROM master_work_schedules WHERE id = ?", [id])

define create_work_schedule taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO master_work_schedules (company_id, name, work_start, work_end, grace_period_minutes, is_default, office_lat, office_lng, geofence_radius) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
      [d.company_id, d.name, d.work_start, d.work_end,
       map.get(d, "grace_period_minutes", 15),
       map.get(d, "is_default", false),
       map.get(d, "office_lat", nothing),
       map.get(d, "office_lng", nothing),
       map.get(d, "geofence_radius", 0)])
    db.last_id(config.conn)
  }

define update_work_schedule taking d ->
  db.exec(config.conn,
    "UPDATE master_work_schedules SET name=?, work_start=?, work_end=?, grace_period_minutes=?, is_default=?, office_lat=?, office_lng=?, geofence_radius=?, updated_at=NOW() WHERE id=?",
    [d.name, d.work_start, d.work_end,
     map.get(d, "grace_period_minutes", 15),
     map.get(d, "is_default", false),
     map.get(d, "office_lat", nothing),
     map.get(d, "office_lng", nothing),
     map.get(d, "geofence_radius", 0),
     d.id])

define delete_work_schedule taking id ->
  db.exec(config.conn, "UPDATE master_work_schedules SET is_active=0 WHERE id=?", [id])

-- ─── Late Rules ───────────────────────────────────────────────────────────────

define list_late_rules taking company_id ->
  db.query(config.conn,
    "SELECT * FROM master_late_rules WHERE company_id = ? ORDER BY min_minutes",
    [company_id])

define find_late_rule taking id ->
  db.query_one(config.conn, "SELECT * FROM master_late_rules WHERE id = ?", [id])

define create_late_rule taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO master_late_rules (company_id, min_minutes, max_minutes, deduction_type, deduction_amount, description) VALUES (?, ?, ?, ?, ?, ?)",
      [d.company_id, d.min_minutes,
       map.get(d, "max_minutes", nothing),
       map.get(d, "deduction_type", "fixed"),
       map.get(d, "deduction_amount", 0),
       map.get(d, "description", nothing)])
    db.last_id(config.conn)
  }

define update_late_rule taking d ->
  db.exec(config.conn,
    "UPDATE master_late_rules SET min_minutes=?, max_minutes=?, deduction_type=?, deduction_amount=?, description=? WHERE id=?",
    [d.min_minutes,
     map.get(d, "max_minutes", nothing),
     map.get(d, "deduction_type", "fixed"),
     map.get(d, "deduction_amount", 0),
     map.get(d, "description", nothing),
     d.id])

define delete_late_rule taking id ->
  db.exec(config.conn, "DELETE FROM master_late_rules WHERE id=?", [id])
