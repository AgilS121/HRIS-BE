  when company_id == nothing
    -> respond 400 response.bad_request("company_id is required")
    otherwise -> respond response.ok(service.list_late_rules(company_id))
}

route POST "/api/master/late-rules" -> do {
  let claims = auth_middleware.require_auth(request)
  when body.company_id == nothing or body.min_minutes == nothing
    -> respond 400 response.bad_request("company_id, min_minutes are required")
    otherwise -> do {
      let new_id = service.create_late_rule(body)
      respond 201 response.ok(service.find_late_rule(new_id))
    }
}

route PUT "/api/master/late-rules/:id" -> do {
  let claims = auth_middleware.require_auth(request)
  let rule   = service.find_late_rule(id)
  when rule == nothing
    -> respond 404 response.not_found("late rule")
    otherwise -> do {
      service.update_late_rule(map {
        id:               id,
        min_minutes:      body.min_minutes,
        max_minutes:      map.get(body, "max_minutes", nothing),
        deduction_type:   map.get(body, "deduction_type", "fixed"),
        deduction_amount: map.get(body, "deduction_amount", 0),
        description:      map.get(body, "description", nothing)
      })
      respond response.ok(service.find_late_rule(id))
    }
}

route DELETE "/api/master/late-rules/:id" -> do {
  let claims = auth_middleware.require_auth(request)
  let rule   = service.find_late_rule(id)
  when rule == nothing
    -> respond 404 response.not_found("late rule")
    otherwise -> do {
      service.delete_late_rule(id)
      respond response.ok(map { message: "late rule deleted" })
    }
}

