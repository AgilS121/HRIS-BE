let mgr_uid = db.last_id(config.conn)

db.exec(config.conn,
  "INSERT INTO auth_users (email, password_hash, name, is_temp_password, role_id) VALUES (?, ?, 'Budi Simantara', 0, ?)",
  ["IT-2026002", crypto.hash_password("Staff2026!"), staff_role_id])
