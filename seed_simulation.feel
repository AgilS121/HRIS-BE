-- ─── Auth Users ───────────────────────────────────────────────────────────────
-- Login menggunakan employee_no (disimpan di kolom email)
-- is_temp_password = 0 → tidak wajib ganti password

db.exec(config.conn,
  "INSERT INTO auth_users (email, password_hash, name, is_temp_password) VALUES (?, ?, 'Super Admin', 0)",
  ["superadmin", crypto.hash_password("Admin2026!")])
let sa_uid = db.last_id(config.conn)

db.exec(config.conn,
  "INSERT INTO auth_users (email, password_hash, name, is_temp_password, role_id) VALUES (?, ?, 'Sari Rahayu', 0, ?)",
  ["HR-2026001", crypto.hash_password("HRD2026!"), hr_role_id])
let hr_uid = db.last_id(config.conn)

db.exec(config.conn,
  "INSERT INTO auth_users (email, password_hash, name, is_temp_password, role_id) VALUES (?, ?, 'Rudi Santoso', 0, ?)",
