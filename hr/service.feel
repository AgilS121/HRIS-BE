-- hr/service.feel — HR business logic.
-- Cross-module: find_employee(id) is the public API for other modules.

import config

-- ─── Employees ───────────────────────────────────────────────────────────────

define list_employees taking company_id ->
  db.query(config.conn,
    "SELECT e.*, d.name AS department_name, p.name AS position_name FROM hr_employees e LEFT JOIN master_departments d ON e.department_id = d.id LEFT JOIN master_positions p ON e.position_id = p.id WHERE e.company_id = ? AND e.status NOT IN ('resigned','terminated') ORDER BY e.full_name",
    [company_id])

define find_employee taking id ->
  db.query_one(config.conn,
    "SELECT e.*, d.name AS department_name, p.name AS position_name FROM hr_employees e LEFT JOIN master_departments d ON e.department_id = d.id LEFT JOIN master_positions p ON e.position_id = p.id WHERE e.id = ?",
    [id])

define find_employee_by_user_id taking user_id ->
  db.query_one(config.conn,
    "SELECT e.*, d.name AS department_name, p.name AS position_name FROM hr_employees e LEFT JOIN master_departments d ON e.department_id = d.id LEFT JOIN master_positions p ON e.position_id = p.id WHERE e.user_id = ?",
    [user_id])

define create_employee taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO hr_employees (company_id, department_id, position_id, employee_no, full_name, gender, email, phone, join_date, employment_type) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
      [d.company_id, d.department_id, d.position_id, d.employee_no, d.full_name,
       map.get(d, "gender", "M"),
       map.get(d, "email", nothing), map.get(d, "phone", nothing),
       d.join_date, map.get(d, "employment_type", "permanent")])
    db.last_id(config.conn)
  }

define update_employee taking d ->
  db.exec(config.conn,
    "UPDATE hr_employees SET department_id=?, position_id=?, full_name=?, email=?, phone=?, employment_type=?, updated_at=NOW() WHERE id=?",
    [d.department_id, d.position_id, d.full_name,
     map.get(d, "email", nothing), map.get(d, "phone", nothing),
     map.get(d, "employment_type", "permanent"), d.id])

define terminate_employee taking id ->
  db.exec(config.conn,
    "UPDATE hr_employees SET status='terminated', updated_at=NOW() WHERE id=?",
    [id])

-- ─── Attendance ──────────────────────────────────────────────────────────────

define get_today_attendance taking employee_id ->
  db.query_one(config.conn,
    "SELECT * FROM hr_attendance WHERE employee_id = ? AND work_date = CURDATE()",
    [employee_id])

-- Get default work schedule for a company
define get_work_schedule taking company_id ->
  db.query_one(config.conn,
    "SELECT * FROM master_work_schedules WHERE company_id = ? AND is_default = 1 AND is_active = 1 LIMIT 1",
    [company_id])

-- Get late deduction rules for a company, ordered by min_minutes
define get_late_rules taking company_id ->
  db.query(config.conn,
    "SELECT * FROM master_late_rules WHERE company_id = ? ORDER BY min_minutes ASC",
    [company_id])

-- Calculate late status + deduction for a clock-in at the current moment.
-- Returns map { status, minutes_late, deduction_amount }
define get_clock_in_status taking company_id ->
  do {
    let schedule = get_work_schedule(company_id)
    when schedule == nothing
      -> map { status: "present", minutes_late: 0, deduction_amount: 0 }
      otherwise -> do {
        let late_row = db.query_one(config.conn,
          "SELECT GREATEST(0, TIMESTAMPDIFF(MINUTE, CONCAT(CURDATE(), ' ', ?), NOW()) - ?) AS minutes_late",
          [schedule.work_start, schedule.grace_period_minutes])
        let mins  = map.get(late_row, "minutes_late", 0)
        let rules = get_late_rules(company_id)
        let matched   = list.filter(rules, fn r ->
          mins >= r.min_minutes and (r.max_minutes == nothing or mins < r.max_minutes))
        let first_rule = list.first(matched)
        let deduction  = when first_rule != nothing -> first_rule.deduction_amount otherwise -> 0
        map {
          status:           when mins > 0 -> "late" otherwise -> "present",
          minutes_late:     mins,
          deduction_amount: deduction
        }
      }
  }

-- Auto-close any open attendance record from a previous day (no checkout)
define auto_close_previous_day taking employee_id ->
  db.exec(config.conn,
    "UPDATE hr_attendance SET status='no_checkout', note=COALESCE(CONCAT(note, ' | auto-closed: no checkout'), 'auto-closed: no checkout'), updated_at=NOW() WHERE employee_id=? AND work_date < CURDATE() AND clock_in_at IS NOT NULL AND clock_out_at IS NULL",
    [employee_id])

define clock_in taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO hr_attendance (employee_id, work_date, clock_in_at, clock_in_lat, clock_in_lng, selfie_in_path, status, minutes_late, deduction_amount, note) VALUES (?, CURDATE(), NOW(), ?, ?, ?, ?, ?, ?, ?)",
      [d.employee_id, map.get(d, "lat", nothing), map.get(d, "lng", nothing),
       map.get(d, "selfie_path", nothing),
       map.get(d, "status", "present"),
       map.get(d, "minutes_late", 0),
       map.get(d, "deduction_amount", 0),
       map.get(d, "note", nothing)])
    db.last_id(config.conn)
  }

define clock_out taking d ->
  db.exec(config.conn,
    "UPDATE hr_attendance SET clock_out_at=NOW(), clock_out_lat=?, clock_out_lng=?, selfie_out_path=?, updated_at=NOW() WHERE employee_id=? AND work_date=CURDATE() AND clock_in_at IS NOT NULL AND clock_out_at IS NULL",
    [map.get(d, "lat", nothing), map.get(d, "lng", nothing),
     map.get(d, "selfie_path", nothing), d.employee_id])

define list_attendance taking d ->
  db.query(config.conn,
    "SELECT a.*, e.full_name AS employee_name, e.employee_no FROM hr_attendance a JOIN hr_employees e ON a.employee_id = e.id WHERE e.company_id = ? AND a.work_date BETWEEN ? AND ? ORDER BY a.work_date DESC, e.full_name",
    [d.company_id, d.date_from, d.date_to])

define list_my_attendance taking d ->
  db.query(config.conn,
    "SELECT * FROM hr_attendance WHERE employee_id = ? AND YEAR(work_date) = ? AND MONTH(work_date) = ? ORDER BY work_date DESC",
    [d.employee_id, d.year, d.month])

define find_attendance taking id ->
  db.query_one(config.conn,
    "SELECT a.*, e.full_name AS employee_name, e.employee_no FROM hr_attendance a JOIN hr_employees e ON a.employee_id = e.id WHERE a.id = ?",
    [id])

define create_attendance taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO hr_attendance (employee_id, work_date, clock_in_at, clock_out_at, status, note) VALUES (?, ?, ?, ?, ?, ?)",
      [d.employee_id, d.work_date, map.get(d, "clock_in_at", nothing), map.get(d, "clock_out_at", nothing), map.get(d, "status", "present"), map.get(d, "note", nothing)])
    db.last_id(config.conn)
  }

define update_attendance taking d ->
  db.exec(config.conn,
    "UPDATE hr_attendance SET clock_in_at=?, clock_out_at=?, status=?, note=?, updated_at=NOW() WHERE id=?",
    [map.get(d, "clock_in_at", nothing), map.get(d, "clock_out_at", nothing), map.get(d, "status", "present"), map.get(d, "note", nothing), d.id])

define delete_attendance taking id ->
  db.exec(config.conn, "DELETE FROM hr_attendance WHERE id=?", [id])

-- ─── Leave Types (Policy) ────────────────────────────────────────────────────

define list_leave_types taking company_id ->
  db.query(config.conn,
    "SELECT * FROM hr_leave_types WHERE company_id = ? AND is_active = 1 ORDER BY name",
    [company_id])

define find_leave_type taking id ->
  db.query_one(config.conn, "SELECT * FROM hr_leave_types WHERE id = ?", [id])

define create_leave_type taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO hr_leave_types (company_id, code, name, default_quota_days, is_paid, requires_attachment, min_days_advance, carry_over_max, is_encashable) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
      [d.company_id, d.code, d.name,
       map.get(d, "default_quota_days", 0), map.get(d, "is_paid", true),
       map.get(d, "requires_attachment", false), map.get(d, "min_days_advance", 0),
       map.get(d, "carry_over_max", 0), map.get(d, "is_encashable", false)])
    db.last_id(config.conn)
  }

define update_leave_type taking d ->
  db.exec(config.conn,
    "UPDATE hr_leave_types SET name=?, default_quota_days=?, is_paid=?, requires_attachment=?, min_days_advance=?, carry_over_max=?, is_encashable=?, updated_at=NOW() WHERE id=?",
    [d.name, map.get(d, "default_quota_days", 0), map.get(d, "is_paid", true),
     map.get(d, "requires_attachment", false), map.get(d, "min_days_advance", 0),
     map.get(d, "carry_over_max", 0), map.get(d, "is_encashable", false), d.id])

define deactivate_leave_type taking id ->
  db.exec(config.conn, "UPDATE hr_leave_types SET is_active=0 WHERE id=?", [id])

-- ─── Leave Balances ──────────────────────────────────────────────────────────

define get_leave_balance taking d ->
  db.query_one(config.conn,
    "SELECT *, (quota_days + adjusted_days + carried_over_days - used_days) AS remaining_days FROM hr_leave_balances WHERE employee_id = ? AND leave_type_id = ? AND year = ?",
    [d.employee_id, d.leave_type_id, d.year])

define list_leave_balances_by_employee taking d ->
  db.query(config.conn,
    "SELECT b.*, lt.name AS leave_type_name, lt.code, lt.is_paid, lt.is_encashable, (b.quota_days + b.adjusted_days + b.carried_over_days - b.used_days) AS remaining_days FROM hr_leave_balances b JOIN hr_leave_types lt ON b.leave_type_id = lt.id WHERE b.employee_id = ? AND b.year = ? ORDER BY lt.name",
    [d.employee_id, d.year])

define list_all_leave_balances taking d ->
  db.query(config.conn,
    "SELECT b.*, e.full_name AS employee_name, e.employee_no, lt.name AS leave_type_name, lt.code, (b.quota_days + b.adjusted_days + b.carried_over_days - b.used_days) AS remaining_days FROM hr_leave_balances b JOIN hr_employees e ON b.employee_id = e.id JOIN hr_leave_types lt ON b.leave_type_id = lt.id WHERE e.company_id = ? AND b.year = ? ORDER BY e.full_name, lt.name",
    [d.company_id, d.year])

define init_leave_balance taking d ->
  db.exec(config.conn,
    "INSERT INTO hr_leave_balances (employee_id, leave_type_id, year, quota_days) VALUES (?, ?, ?, ?) ON DUPLICATE KEY UPDATE quota_days=VALUES(quota_days), updated_at=NOW()",
    [d.employee_id, d.leave_type_id, d.year, d.quota_days])

define adjust_leave_balance taking d ->
  do {
    db.exec(config.conn,
      "UPDATE hr_leave_balances SET adjusted_days = adjusted_days + ?, updated_at=NOW() WHERE employee_id=? AND leave_type_id=? AND year=?",
      [d.days, d.employee_id, d.leave_type_id, d.year])
    db.exec(config.conn,
      "INSERT INTO hr_leave_adjustments (employee_id, leave_type_id, year, days, reason, adjusted_by) VALUES (?, ?, ?, ?, ?, ?)",
      [d.employee_id, d.leave_type_id, d.year, d.days, d.reason, map.get(d, "adjusted_by", nothing)])
  }

-- ─── Leave Requests ──────────────────────────────────────────────────────────

define list_leave_requests taking d ->
  db.query(config.conn,
    "SELECT r.*, e.full_name AS employee_name, e.employee_no, lt.name AS leave_type_name, lt.code FROM hr_leave_requests r JOIN hr_employees e ON r.employee_id = e.id JOIN hr_leave_types lt ON r.leave_type_id = lt.id WHERE e.company_id = ? ORDER BY r.created_at DESC",
    [d.company_id])

define list_pending_requests taking company_id ->
  db.query(config.conn,
    "SELECT r.*, e.full_name AS employee_name, e.employee_no, lt.name AS leave_type_name, lt.code FROM hr_leave_requests r JOIN hr_employees e ON r.employee_id = e.id JOIN hr_leave_types lt ON r.leave_type_id = lt.id WHERE e.company_id = ? AND r.status = 'pending' ORDER BY r.created_at ASC",
    [company_id])

define list_leave_requests_by_employee taking employee_id ->
  db.query(config.conn,
    "SELECT r.*, lt.name AS leave_type_name, lt.code FROM hr_leave_requests r JOIN hr_leave_types lt ON r.leave_type_id = lt.id WHERE r.employee_id = ? ORDER BY r.created_at DESC",
    [employee_id])

define find_leave_request taking id ->
  db.query_one(config.conn,
    "SELECT r.*, e.full_name AS employee_name, lt.name AS leave_type_name FROM hr_leave_requests r JOIN hr_employees e ON r.employee_id = e.id JOIN hr_leave_types lt ON r.leave_type_id = lt.id WHERE r.id = ?",
    [id])

define create_leave_request taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO hr_leave_requests (employee_id, leave_type_id, start_date, end_date, total_days, reason, attachment_path) VALUES (?, ?, ?, ?, ?, ?, ?)",
      [d.employee_id, d.leave_type_id, d.start_date, d.end_date, d.total_days,
       map.get(d, "reason", nothing), map.get(d, "attachment_path", nothing)])
    db.last_id(config.conn)
  }

define approve_leave_request taking d ->
  -- d.user_id = auth_users.id; subquery resolves to hr_employees.id (nullable)
  do {
    let req = find_leave_request(d.id)
    db.exec(config.conn,
      "UPDATE hr_leave_requests SET status='approved', approved_by=(SELECT id FROM hr_employees WHERE user_id=? LIMIT 1), approved_at=NOW(), updated_at=NOW() WHERE id=? AND status='pending'",
      [d.user_id, d.id])
    when req != nothing ->
      db.exec(config.conn,
        "UPDATE hr_leave_balances SET used_days = used_days + ?, updated_at=NOW() WHERE employee_id=? AND leave_type_id=? AND year=YEAR(?)",
        [req.total_days, req.employee_id, req.leave_type_id, req.start_date])
  }

define reject_leave_request taking d ->
  -- d.user_id = auth_users.id; subquery resolves to hr_employees.id (nullable)
  db.exec(config.conn,
    "UPDATE hr_leave_requests SET status='rejected', approved_by=(SELECT id FROM hr_employees WHERE user_id=? LIMIT 1), approved_at=NOW(), rejection_note=?, updated_at=NOW() WHERE id=? AND status='pending'",
    [d.user_id, map.get(d, "note", nothing), d.id])

define cancel_leave_request taking d ->
  do {
    let req = find_leave_request(d.id)
    db.exec(config.conn,
      "UPDATE hr_leave_requests SET status='cancelled', cancel_reason=?, cancelled_at=NOW(), cancelled_by=?, updated_at=NOW() WHERE id=? AND status IN ('pending','approved')",
      [map.get(d, "reason", nothing), map.get(d, "cancelled_by", nothing), d.id])
    when req != nothing and req.status == "approved" ->
      db.exec(config.conn,
        "UPDATE hr_leave_balances SET used_days = GREATEST(0, used_days - ?), updated_at=NOW() WHERE employee_id=? AND leave_type_id=? AND year=YEAR(?)",
        [req.total_days, req.employee_id, req.leave_type_id, req.start_date])
  }

-- ─── Employee Number Generation ───────────────────────────────────────────────
-- Format: {DEPT_CODE}-{YEAR}{3-digit-seq}  e.g. IT-2026001, HR-2026002

define generate_employee_no taking department_id ->
  do {
    let yr_row = db.query_one(config.conn, "SELECT YEAR(NOW()) AS y", [])
    let year   = yr_row.y
    let dept   = db.query_one(config.conn,
                   "SELECT code FROM master_departments WHERE id = ?",
                   [department_id])
    let prefix = when dept != nothing -> dept.code otherwise -> "EMP"
    db.exec(config.conn,
      "INSERT INTO hr_employee_no_seq (department_id, year, last_seq) VALUES (?, ?, 1) ON DUPLICATE KEY UPDATE last_seq = last_seq + 1",
      [department_id, year])
    let seq_row = db.query_one(config.conn,
                    "SELECT last_seq FROM hr_employee_no_seq WHERE department_id = ? AND year = ?",
                    [department_id, year])
    let seq     = seq_row.last_seq
    let seq_str = when seq < 10 -> "00{seq}"
                  otherwise -> when seq < 100 -> "0{seq}"
                  otherwise -> "{seq}"
    "{prefix}-{year}{seq_str}"
  }

-- ─── Employee Full CRUD ───────────────────────────────────────────────────────

define create_employee_full taking d ->
  do {
    db.exec(config.conn,
      "INSERT INTO hr_employees (company_id, department_id, position_id, user_id, employee_no, full_name, nickname, gender, email, phone, birth_place, birth_date, national_id, tax_id, marital_status, address, join_date, employment_type, contract_number, contract_start, contract_end, contract_months, bank_name, bank_account_no, bank_account_name, salary_grade, basic_salary) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
      [d.company_id, d.department_id, d.position_id, map.get(d, "user_id", nothing),
       d.employee_no, d.full_name,
       map.get(d, "nickname", nothing),
       map.get(d, "gender", "M"),
       map.get(d, "email", nothing),
       map.get(d, "phone", nothing),
       map.get(d, "birth_place", nothing),
       map.get(d, "birth_date", nothing),
       map.get(d, "national_id", nothing),
       map.get(d, "tax_id", nothing),
       map.get(d, "marital_status", "single"),
       map.get(d, "address", nothing),
       d.join_date,
       map.get(d, "employment_type", "permanent"),
       map.get(d, "contract_number", nothing),
       map.get(d, "contract_start", nothing),
       map.get(d, "contract_end", nothing),
       map.get(d, "contract_months", nothing),
       map.get(d, "bank_name", nothing),
       map.get(d, "bank_account_no", nothing),
       map.get(d, "bank_account_name", nothing),
       map.get(d, "salary_grade", nothing),
       map.get(d, "basic_salary", nothing)])
    db.last_id(config.conn)
  }

define update_employee_full taking d ->
  db.exec(config.conn,
    "UPDATE hr_employees SET department_id=?, position_id=?, full_name=?, nickname=?, email=?, phone=?, gender=?, birth_place=?, birth_date=?, national_id=?, tax_id=?, marital_status=?, address=?, employment_type=?, contract_number=?, contract_start=?, contract_end=?, contract_months=?, bank_name=?, bank_account_no=?, bank_account_name=?, salary_grade=?, basic_salary=?, updated_at=NOW() WHERE id=?",
    [d.department_id, d.position_id, d.full_name,
     map.get(d, "nickname", nothing),
     map.get(d, "email", nothing),
     map.get(d, "phone", nothing),
     map.get(d, "gender", "M"),
     map.get(d, "birth_place", nothing),
     map.get(d, "birth_date", nothing),
     map.get(d, "national_id", nothing),
     map.get(d, "tax_id", nothing),
     map.get(d, "marital_status", "single"),
     map.get(d, "address", nothing),
     map.get(d, "employment_type", "permanent"),
     map.get(d, "contract_number", nothing),
     map.get(d, "contract_start", nothing),
     map.get(d, "contract_end", nothing),
     map.get(d, "contract_months", nothing),
     map.get(d, "bank_name", nothing),
     map.get(d, "bank_account_no", nothing),
     map.get(d, "bank_account_name", nothing),
     map.get(d, "salary_grade", nothing),
     map.get(d, "basic_salary", nothing),
     d.id])

define save_contract_file taking d ->
  db.exec(config.conn,
    "UPDATE hr_employees SET contract_number=?, contract_start=?, contract_end=?, contract_months=?, contract_file=?, updated_at=NOW() WHERE id=?",
    [map.get(d, "contract_number", nothing),
     map.get(d, "contract_start", nothing),
     map.get(d, "contract_end", nothing),
     map.get(d, "contract_months", nothing),
     map.get(d, "contract_file", nothing),
     d.id])
