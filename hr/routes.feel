route GET "/api/hr/leave-requests/mine" -> do {
  let claims      = auth_middleware.require_auth(request)
  let employee_id = map.get(query, "employee_id", nothing)
  when employee_id == nothing
    -> respond 400 response.bad_request("employee_id is required")
    otherwise -> respond response.ok(service.list_leave_requests_by_employee(employee_id))
}

route GET "/api/hr/leave-requests/pending" -> do {
  let claims     = auth_middleware.require_auth(request)
  let company_id = map.get(query, "company_id", nothing)
  when company_id == nothing
    -> respond 400 response.bad_request("company_id is required")
    otherwise -> respond response.ok(service.list_pending_requests(company_id))
}

route GET "/api/hr/leave-requests" -> do {
  let claims     = auth_middleware.require_auth(request)
  let company_id = map.get(query, "company_id", nothing)
  when company_id == nothing
    -> respond 400 response.bad_request("company_id query param is required")
    otherwise -> respond response.ok(service.list_leave_requests(map { company_id: company_id }))
}

route POST "/api/hr/leave-requests" -> do {
  let claims = auth_middleware.require_auth(request)
  when body.employee_id == nothing or body.leave_type_id == nothing or body.start_date == nothing or body.end_date == nothing or body.total_days == nothing
    -> respond 400 response.bad_request("employee_id, leave_type_id, start_date, end_date, total_days are required")
    otherwise -> do {
      let f = map.get(files, "attachment", nothing)
      let attachment_path = when f != nothing
        -> do {
          let filename  = "leave_{body.employee_id}_{f.filename}"
          let save_path = "uploads/leave-docs/{filename}"
          f.save_to(save_path)
          save_path
        }
        otherwise -> nothing
      let new_id = service.create_leave_request(map {
        employee_id:     body.employee_id,
        leave_type_id:   body.leave_type_id,
        start_date:      body.start_date,
        end_date:        body.end_date,
        total_days:      body.total_days,
        reason:          body.reason,
        attachment_path: attachment_path
      })
      respond 201 response.ok(service.find_leave_request(new_id))
    }
}

route PUT "/api/hr/leave-requests/:id/approve" -> do {
  let claims   = auth_middleware.require_auth(request)
  let leave_r  = service.find_leave_request(id)
  when leave_r == nothing
    -> respond 404 response.not_found("leave request")
    otherwise -> do {
      when leave_r.status != "pending"
        -> respond 409 response.conflict("leave request is no longer pending")
        otherwise -> do {
          service.approve_leave_request(map { id: id, user_id: claims.user_id })
          respond response.ok(service.find_leave_request(id))
        }
    }
}

route PUT "/api/hr/leave-requests/:id/reject" -> do {
  let claims  = auth_middleware.require_auth(request)
  let leave_r = service.find_leave_request(id)
  when leave_r == nothing
    -> respond 404 response.not_found("leave request")
    otherwise -> do {
      when leave_r.status != "pending"
        -> respond 409 response.conflict("leave request is no longer pending")
        otherwise -> do {
          service.reject_leave_request(map { id: id, user_id: claims.user_id, note: body.note })
          respond response.ok(service.find_leave_request(id))
        }
    }
}

route PUT "/api/hr/leave-requests/:id/cancel" -> do {
  let claims  = auth_middleware.require_auth(request)
  let leave_r = service.find_leave_request(id)
  when leave_r == nothing
    -> respond 404 response.not_found("leave request")
    otherwise -> do {
      when leave_r.status != "pending" and leave_r.status != "approved"
        -> respond 409 response.conflict("only pending or approved requests can be cancelled")
        otherwise -> do {
          service.cancel_leave_request(map {
            id:           id,
            reason:       body.reason,
            cancelled_by: claims.user_id
          })
          respond response.ok(service.find_leave_request(id))
        }
    }
}
