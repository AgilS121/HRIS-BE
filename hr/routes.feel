-- hr/routes.feel — employees, attendance, leave endpoints.

import shared/response
import shared/auth_middleware
import hr/service
import auth/temp_service

-- ─── Employee Self (mobile) ───────────────────────────────────────────────────

-- GET /api/hr/employees/me — profil karyawan yang sedang login (dari JWT)
route GET "/api/hr/employees/me" -> do {
  let claims   = auth_middleware.require_auth(request)
  let employee = service.find_employee_by_user_id(claims.user_id)
  when employee == nothing
    -> respond 404 response.not_found("employee profile for current user")
    otherwise -> respond response.ok(employee)
}

-- ─── Employees ───────────────────────────────────────────────────────────────

route GET "/api/hr/employees" -> do {
  let claims     = auth_middleware.require_auth(request)
  let company_id = map.get(query, "company_id", nothing)
  when company_id == nothing
    -> respond 400 response.bad_request("company_id query param is required")
    otherwise -> respond response.ok(service.list_employees(company_id))
}

route POST "/api/hr/employees" -> do {
  let claims = auth_middleware.require_auth(request)
  when body.company_id == nothing or body.full_name == nothing or body.employee_no == nothing or body.join_date == nothing
    -> respond 400 response.bad_request("company_id, full_name, employee_no, join_date are required")
    otherwise -> do {
      let new_id = service.create_employee(body)
      respond 201 response.ok(service.find_employee(new_id))
    }
}

route GET "/api/hr/employees/:id" -> do {
  let claims   = auth_middleware.require_auth(request)
  let employee = service.find_employee(id)
  when employee == nothing
    -> respond 404 response.not_found("employee")
    otherwise -> respond response.ok(employee)
}

route PUT "/api/hr/employees/:id" -> do {
  let claims   = auth_middleware.require_auth(request)
  let employee = service.find_employee(id)
  when employee == nothing
    -> respond 404 response.not_found("employee")
    otherwise -> do {
      when body.full_name == nothing
        -> respond 400 response.bad_request("full_name is required")
        otherwise -> do {
          let d = map {
            id:              id,
            department_id:   body.department_id,
            position_id:     body.position_id,
            full_name:       body.full_name,
            email:           body.email,
            phone:           body.phone,
            employment_type: body.employment_type
          }
          service.update_employee(d)
          respond response.ok(service.find_employee(id))
        }
    }
}

route DELETE "/api/hr/employees/:id" -> do {
  let claims   = auth_middleware.require_auth(request)
  let employee = service.find_employee(id)
  when employee == nothing
    -> respond 404 response.not_found("employee")
    otherwise -> do {
      service.terminate_employee(id)
      respond response.ok(map { message: "employee terminated" })
    }
}

-- ─── Employee Extended Endpoints ─────────────────────────────────────────────

-- GET /api/hr/employees/next-no?department_id=X
-- Returns the next auto-generated employee number for a given department.
route GET "/api/hr/employees/next-no" -> do {
  let claims  = auth_middleware.require_auth(request)
  let dept_id = map.get(query, "department_id", nothing)
  when dept_id == nothing
    -> respond 400 response.bad_request("department_id is required")
    otherwise -> respond response.ok(map { employee_no: service.generate_employee_no(dept_id) })
}

-- POST /api/hr/employees/full — create employee + auto-create temp login account
route POST "/api/hr/employees/full" -> do {
  let claims = auth_middleware.require_auth(request)
  when body.company_id == nothing or body.full_name == nothing or body.employee_no == nothing or body.join_date == nothing
    -> respond 400 response.bad_request("company_id, full_name, employee_no, join_date are required")
    otherwise -> do {
      -- Create temp auth account (employee_no = username & password, expires 3 days)
      let user_id = temp_service.create_temp_user(map {
        employee_no: body.employee_no,
        full_name:   body.full_name,
        role_id:     body.role_id
      })
      -- Create employee linked to the new auth user
      let emp_body = map {
        company_id:      body.company_id,
        department_id:   body.department_id,
        position_id:     body.position_id,
        employee_no:     body.employee_no,
        full_name:       body.full_name,
        nickname:        body.nickname,
        gender:          body.gender,
        email:           body.email,
        phone:           body.phone,
        birth_place:     body.birth_place,
        birth_date:      body.birth_date,
        national_id:     body.national_id,
        tax_id:          body.tax_id,
        marital_status:  body.marital_status,
        address:         body.address,
        join_date:       body.join_date,
        employment_type: body.employment_type,
        contract_number: body.contract_number,
        contract_start:  body.contract_start,
        contract_end:    body.contract_end,
        contract_months: body.contract_months,
        bank_name:       body.bank_name,
        bank_account_no: body.bank_account_no,
        bank_account_name: body.bank_account_name,
        salary_grade:    body.salary_grade,
        basic_salary:    body.basic_salary,
        user_id:         user_id
      }
      let new_id = service.create_employee_full(emp_body)
      let employee = service.find_employee(new_id)
      respond 201 response.ok(map {
        employee:          employee,
        temp_credentials:  map {
          username: body.employee_no,
          password: body.employee_no,
          expires_in_days: 3
        }
      })
    }
}

-- PUT /api/hr/employees/:id/full — update employee with all profile fields
route PUT "/api/hr/employees/:id/full" -> do {
  let claims   = auth_middleware.require_auth(request)
  let employee = service.find_employee(id)
  when employee == nothing
    -> respond 404 response.not_found("employee")
    otherwise -> do {
      let d = map {
        id:                id,
        department_id:     body.department_id,
        position_id:       body.position_id,
        full_name:         body.full_name,
        nickname:          body.nickname,
        email:             body.email,
        phone:             body.phone,
        gender:            body.gender,
        birth_place:       body.birth_place,
        birth_date:        body.birth_date,
        national_id:       body.national_id,
        tax_id:            body.tax_id,
        marital_status:    body.marital_status,
        address:           body.address,
        employment_type:   body.employment_type,
        contract_number:   body.contract_number,
        contract_start:    body.contract_start,
        contract_end:      body.contract_end,
        contract_months:   body.contract_months,
        bank_name:         body.bank_name,
        bank_account_no:   body.bank_account_no,
        bank_account_name: body.bank_account_name,
        salary_grade:      body.salary_grade,
        basic_salary:      body.basic_salary
      }
      service.update_employee_full(d)
      respond response.ok(service.find_employee(id))
    }
}

-- GET /api/hr/employees/:id/contract — return contract file URL + metadata
route GET "/api/hr/employees/:id/contract" -> do {
  let claims   = auth_middleware.require_auth(request)
  let employee = service.find_employee(id)
  when employee == nothing
    -> respond 404 response.not_found("employee")
    otherwise -> do {
      when employee.contract_file == nothing
        -> respond 404 response.not_found("contract file")
        otherwise -> respond response.ok(map {
          url:             "/" + employee.contract_file,
          contract_number: employee.contract_number,
          contract_start:  employee.contract_start,
          contract_end:    employee.contract_end,
          contract_months: employee.contract_months,
          filename:        employee.contract_file
        })
    }
}

-- POST /api/hr/employees/:id/contract — upload contract file (multipart/form-data)
-- Form fields: contract (file), contract_number, contract_start, contract_end, contract_months
-- File is saved to uploads/contracts/ — ensure this directory exists on the server.
route POST "/api/hr/employees/:id/contract" -> do {
  let claims   = auth_middleware.require_auth(request)
  let employee = service.find_employee(id)
  when employee == nothing
    -> respond 404 response.not_found("employee")
    otherwise -> do {
      let f = map.get(files, "contract", nothing)
      when f == nothing
        -> respond 400 response.bad_request("contract file is required")
        otherwise -> do {
          let filename  = "contract_{id}_{f.filename}"
          let save_path = "uploads/contracts/{filename}"
          f.save_to(save_path)
          let d = map {
            id:              id,
            contract_number: map.get(body, "contract_number", nothing),
            contract_start:  map.get(body, "contract_start", nothing),
            contract_end:    map.get(body, "contract_end", nothing),
            contract_months: map.get(body, "contract_months", nothing),
            contract_file:   save_path
          }
          service.save_contract_file(d)
          respond response.ok(map { message: "contract uploaded", path: save_path })
        }
    }
}

-- ─── Attendance ──────────────────────────────────────────────────────────────

-- POST /api/hr/attendance/clock-in
-- employee_id dari body (admin) atau dari JWT via user_id → employee (mobile)
-- Selfie: multipart field "selfie" (opsional)
route POST "/api/hr/attendance/clock-in" -> do {
  let claims      = auth_middleware.require_auth(request)
  let employee_id = when body.employee_id != nothing
    -> body.employee_id
    otherwise -> do {
      let emp = service.find_employee_by_user_id(claims.user_id)
      when emp != nothing -> emp.id otherwise -> nothing
    }
  when employee_id == nothing
    -> respond 400 response.bad_request("employee_id is required or user has no employee profile")
    otherwise -> do {
      let existing = service.get_today_attendance(employee_id)
      when existing != nothing and existing.clock_in_at != nothing
        -> respond 409 response.conflict("already clocked in today")
        otherwise -> do {
          let f = map.get(files, "selfie", nothing)
          let selfie_path = when f != nothing
            -> do {
              let filename  = "selfie_in_{employee_id}_{f.filename}"
              let save_path = "uploads/selfies/{filename}"
              f.save_to(save_path)
              save_path
            }
            otherwise -> nothing
          let d = map {
            employee_id: employee_id,
            lat:         body.lat,
            lng:         body.lng,
            selfie_path: selfie_path,
            note:        body.note
          }
          let att_id = service.clock_in(d)
          respond 201 response.ok(map { attendance_id: att_id, message: "clock-in recorded" })
        }
    }
}

-- POST /api/hr/attendance/clock-out
-- employee_id dari body (admin) atau dari JWT via user_id → employee (mobile)
route POST "/api/hr/attendance/clock-out" -> do {
  let claims      = auth_middleware.require_auth(request)
  let employee_id = when body.employee_id != nothing
    -> body.employee_id
    otherwise -> do {
      let emp = service.find_employee_by_user_id(claims.user_id)
      when emp != nothing -> emp.id otherwise -> nothing
    }
  when employee_id == nothing
    -> respond 400 response.bad_request("employee_id is required or user has no employee profile")
    otherwise -> do {
      let existing = service.get_today_attendance(employee_id)
      when existing == nothing
        -> respond 404 response.not_found("clock-in record for today")
        otherwise -> do {
          when existing.clock_in_at == nothing
            -> respond 409 response.conflict("not clocked in today")
            otherwise -> do {
              when existing.clock_out_at != nothing
                -> respond 409 response.conflict("already clocked out today")
                otherwise -> do {
                  let f = map.get(files, "selfie", nothing)
                  let selfie_path = when f != nothing
                    -> do {
                      let filename  = "selfie_out_{employee_id}_{f.filename}"
                      let save_path = "uploads/selfies/{filename}"
                      f.save_to(save_path)
                      save_path
                    }
                    otherwise -> nothing
                  let d = map {
                    employee_id: employee_id,
                    lat:         body.lat,
                    lng:         body.lng,
                    selfie_path: selfie_path
                  }
                  service.clock_out(d)
                  respond response.ok(map { message: "clock-out recorded" })
                }
            }
        }
    }
}

-- GET /api/hr/attendance/today — status absen hari ini (dari JWT, untuk mobile)
route GET "/api/hr/attendance/today" -> do {
  let claims = auth_middleware.require_auth(request)
  let emp    = service.find_employee_by_user_id(claims.user_id)
  when emp == nothing
    -> respond 404 response.not_found("employee profile for current user")
    otherwise -> do {
      let rec = service.get_today_attendance(emp.id)
      respond response.ok(when rec != nothing -> rec otherwise -> map { clocked_in: false })
    }
}

-- GET /api/hr/attendance/my?year=&month= — riwayat absen sendiri (dari JWT, untuk mobile)
route GET "/api/hr/attendance/my" -> do {
  let claims = auth_middleware.require_auth(request)
  let emp    = service.find_employee_by_user_id(claims.user_id)
  when emp == nothing
    -> respond 404 response.not_found("employee profile for current user")
    otherwise -> do {
      let year  = map.get(query, "year", nothing)
      let month = map.get(query, "month", nothing)
      when year == nothing or month == nothing
        -> respond 400 response.bad_request("year and month query params are required")
        otherwise -> respond response.ok(service.list_my_attendance(map {
          employee_id: emp.id,
          year:        year,
          month:       month
        }))
    }
}

route GET "/api/hr/attendance" -> do {
  let claims     = auth_middleware.require_auth(request)
  let company_id = map.get(query, "company_id", nothing)
  let date_from  = map.get(query, "date_from", nothing)
  let date_to    = map.get(query, "date_to", nothing)
  when company_id == nothing or date_from == nothing or date_to == nothing
    -> respond 400 response.bad_request("company_id, date_from, date_to query params are required")
    otherwise -> do {
      let d = map { company_id: company_id, date_from: date_from, date_to: date_to }
      respond response.ok(service.list_attendance(d))
    }
}

route POST "/api/hr/attendance" -> do {
  let claims = auth_middleware.require_auth(request)
  when body.employee_id == nothing or body.work_date == nothing
    -> respond 400 response.bad_request("employee_id and work_date are required")
    otherwise -> do {
      let new_id = service.create_attendance(map {
        employee_id:  body.employee_id,
        work_date:    body.work_date,
        clock_in_at:  body.clock_in_at,
        clock_out_at: body.clock_out_at,
        status:       map.get(body, "status", "present"),
        note:         body.note
      })
      respond 201 response.ok(service.find_attendance(new_id))
    }
}

route PUT "/api/hr/attendance/:id" -> do {
  let claims = auth_middleware.require_auth(request)
  let rec    = service.find_attendance(id)
  when rec == nothing
    -> respond 404 response.not_found("attendance record")
    otherwise -> do {
      service.update_attendance(map {
        id:           id,
        clock_in_at:  body.clock_in_at,
        clock_out_at: body.clock_out_at,
        status:       map.get(body, "status", rec.status),
        note:         body.note
      })
      respond response.ok(service.find_attendance(id))
    }
}

route DELETE "/api/hr/attendance/:id" -> do {
  let claims = auth_middleware.require_auth(request)
  let rec    = service.find_attendance(id)
  when rec == nothing
    -> respond 404 response.not_found("attendance record")
    otherwise -> do {
      service.delete_attendance(id)
      respond response.ok(map { message: "attendance record deleted" })
    }
}

-- ─── Leave Types ─────────────────────────────────────────────────────────────

route GET "/api/hr/leave-types" -> do {
  let claims     = auth_middleware.require_auth(request)
  let company_id = map.get(query, "company_id", nothing)
  when company_id == nothing
    -> respond 400 response.bad_request("company_id query param is required")
    otherwise -> respond response.ok(service.list_leave_types(company_id))
}

route POST "/api/hr/leave-types" -> do {
  let claims = auth_middleware.require_auth(request)
  when body.company_id == nothing or body.code == nothing or body.name == nothing
    -> respond 400 response.bad_request("company_id, code, name are required")
    otherwise -> do {
      let new_id = service.create_leave_type(body)
      respond 201 response.ok(service.find_leave_type(new_id))
    }
}

route PUT "/api/hr/leave-types/:id" -> do {
  let claims = auth_middleware.require_auth(request)
  let lt     = service.find_leave_type(id)
  when lt == nothing
    -> respond 404 response.not_found("leave type")
    otherwise -> do {
      service.update_leave_type(map {
        id:                   id,
        name:                 map.get(body, "name", lt.name),
        default_quota_days:   map.get(body, "default_quota_days", lt.default_quota_days),
        is_paid:              map.get(body, "is_paid", lt.is_paid),
        requires_attachment:  map.get(body, "requires_attachment", lt.requires_attachment),
        min_days_advance:     map.get(body, "min_days_advance", lt.min_days_advance),
        carry_over_max:       map.get(body, "carry_over_max", lt.carry_over_max),
        is_encashable:        map.get(body, "is_encashable", lt.is_encashable)
      })
      respond response.ok(service.find_leave_type(id))
    }
}

route DELETE "/api/hr/leave-types/:id" -> do {
  let claims = auth_middleware.require_auth(request)
  let lt     = service.find_leave_type(id)
  when lt == nothing
    -> respond 404 response.not_found("leave type")
    otherwise -> do {
      service.deactivate_leave_type(id)
      respond response.ok(map { message: "leave type deactivated" })
    }
}

-- ─── Leave Balances ──────────────────────────────────────────────────────────

route GET "/api/hr/leave-balances" -> do {
