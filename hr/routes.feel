  let employee_id = map.get(query, "employee_id", nothing)
  let year        = map.get(query, "year", nothing)
  when employee_id == nothing or year == nothing
    -> respond 400 response.bad_request("employee_id and year are required")
    otherwise -> respond response.ok(service.list_leave_balances_by_employee(map { employee_id: employee_id, year: year }))
}

route GET "/api/hr/leave-balances/all" -> do {
  let claims     = auth_middleware.require_auth(request)
  let company_id = map.get(query, "company_id", nothing)
  let year       = map.get(query, "year", nothing)
  when company_id == nothing or year == nothing
    -> respond 400 response.bad_request("company_id and year are required")
    otherwise -> respond response.ok(service.list_all_leave_balances(map { company_id: company_id, year: year }))
}

route POST "/api/hr/leave-balances/init" -> do {
  let claims = auth_middleware.require_auth(request)
  when body.employee_id == nothing or body.leave_type_id == nothing or body.year == nothing or body.quota_days == nothing
    -> respond 400 response.bad_request("employee_id, leave_type_id, year, quota_days are required")
    otherwise -> do {
      service.init_leave_balance(map {
        employee_id:   body.employee_id,
        leave_type_id: body.leave_type_id,
        year:          body.year,
        quota_days:    body.quota_days
      })
      respond response.ok(map { message: "balance initialized" })
    }
}

route POST "/api/hr/leave-adjustments" -> do {
  let claims = auth_middleware.require_auth(request)
  when body.employee_id == nothing or body.leave_type_id == nothing or body.year == nothing or body.days == nothing or body.reason == nothing
    -> respond 400 response.bad_request("employee_id, leave_type_id, year, days, reason are required")
    otherwise -> do {
      service.adjust_leave_balance(map {
        employee_id:   body.employee_id,
        leave_type_id: body.leave_type_id,
        year:          body.year,
        days:          body.days,
        reason:        body.reason,
        adjusted_by:   claims.user_id
      })
      respond response.ok(map { message: "balance adjusted" })
    }
}

