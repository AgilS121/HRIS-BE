-- migrate.feel — custom migrator yang baca .sql files.
-- stdlib `migrate.apply` cuma support .feel files; kita override supaya SQL stays SQL.
--
-- Cara kerja:
--   1. Bikin tabel `schema_migrations` (tracker) kalau belum ada
--   2. Loop *.sql files di migrations/ (alphabetical)
--   3. Skip yang sudah ada di schema_migrations
--   4. Split content per statement (split `;\n`), exec masing-masing
--   5. Record di schema_migrations

import config

-- Init tracker table
db.exec(config.conn, "CREATE TABLE IF NOT EXISTS schema_migrations (
  id          VARCHAR(255) PRIMARY KEY,
  applied_at  TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4")

-- Discover files
let all_files = file.list_dir("migrations/")
let sql_files = list.filter(all_files, fn f -> string.ends_with(f, ".sql"))
let sorted_files = list.sort(sql_files)

let applied_count = 0
let skipped_count = 0

for filename in sorted_files -> do {
  let already = db.query_one(
    config.conn,
    "SELECT id FROM schema_migrations WHERE id = ?",
    [filename]
  )

  when already != nothing -> do {
    show -> "  skip  {filename}"
    let skipped_count = skipped_count + 1
  }
  otherwise -> do {
    show -> "  apply {filename}"
    let sql_text = file.read("migrations/" + filename)

    -- Strip seluruh line comment `-- ...` dulu. Sisanya split per statement.
    -- MySQL ignore inline `--` comment juga tapi lebih bersih kalau di-strip.
    let raw_lines = string.lines(sql_text)
    let code_lines = list.filter(raw_lines, fn l ->
      not string.starts_with(string.trim(l), "--")
    )
    let cleaned = join(code_lines, "\n")
    let pieces = split(cleaned, ";\n")
    for piece in pieces -> do {
      let stmt = string.trim(piece)
      when length(stmt) > 0 ->
        db.exec(config.conn, stmt)
      otherwise -> nothing
    }

    db.exec(
      config.conn,
      "INSERT INTO schema_migrations (id) VALUES (?)",
      [filename]
    )
    show -> "    ✓ done"
  }
}

show -> "[migrate] selesai"
